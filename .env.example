# Frontend Environment Variables (Configure in Vercel / Netlify Settings)
# Supabase Configuration (Real-time PostgreSQL Database)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_anon_key

# NBC Bakong KHQR Configuration
VITE_BAKONG_API_TOKEN=your_bakong_api_token
VITE_BAKONG_ACCOUNT_ID=merchant_id@bkrt
VITE_BAKONG_MERCHANT_NAME="Store Merchant Name"
VITE_BAKONG_PHONE=0968350317
VITE_BAKONG_API_URL=https://api-bakong.nbc.gov.kh

# Telegram Notification Bot Gateway (Keep secret, do not commit production tokens)
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
VITE_TELEGRAM_CHAT_ID=your_telegram_chat_id
