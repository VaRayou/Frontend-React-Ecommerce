# ==============================================================================
# STEAV LUXURY E-COMMERCE — ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL CREDENTIALS, SECRETS, OR TOKENS TO SOURCE CONTROL!
# ==============================================================================

# Client-Side Public Variables (Vite - Exposed in Browser Bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Serverless API / Backend Secrets (Vercel Serverless Only - NEVER expose to browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Bakong KHQR Settlement Gateway (NBC National Bank of Cambodia)
BAKONG_API_TOKEN=your-bakong-developer-token
BAKONG_MERCHANT_ID=your-bakong-account-id@bank
BAKONG_MERCHANT_NAME="STEAV STORE"
BAKONG_MERCHANT_CITY="Phnom Penh"

# Telegram Bot Integration (Internal Orders & Security Alerts)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-admin-chat-id
TELEGRAM_SECURITY_CHAT_ID=your-private-security-group-chat-id
TELEGRAM_WEBHOOK_SECRET=your-random-generated-secret-string

# Security Monitoring & Brute-Force Thresholds (Optional)
SECURITY_LOGIN_FAIL_THRESHOLD=5
SECURITY_LOGIN_WINDOW_SEC=300
SECURITY_ALERT_DEDUPE_SEC=120
SECURITY_NOTIFY_SEVERITIES=CRITICAL,HIGH,MEDIUM

# Transactional Email Gateway (Brevo / Resend)
BREVO_API_KEY=your-brevo-api-key
RESEND_API_KEY=your-resend-api-key
ADMIN_EMAIL=admin@youngsteav.site
